"""
Runs the GPU optimization and tracks both Classical and MK-TS convergence.
"""
function gpu_topopt_3d_mkts(;
    nx=60, ny=20, nz=10, 
    volfrac=0.5, rmin=2.0, penal=3.0, E=1.0, ν=0.3, 
    maxiter=2000, tolx=0.01, 
    preset_name="Normal", alpha=0.05, slopeTolRel=1e-3, winSize=20, minIter=40, relaxFactor=2.0, safeguardAt=2000,
    verbose=false
)
    # Initialization and GPU Transfers (Same as your original script)
    nelems = nx * ny * nz
    nnodes = (nx+1) * (ny+1) * (nz+1)
    ndofs = 3 * nnodes

    Ke0 = hex8_stiffness_matrix(E, ν)
    edof = build_edof_table(nx, ny, nz)

    K = spzeros(ndofs, ndofs)
    for e in 1:nelems
        for i in 1:24, j in 1:24
            K[edof[e,i], edof[e,j]] += Ke0[i,j]
        end
    end

    fixed_dofs = Int32[]
    for j in 1:(ny+1), k in 1:(nz+1)
        node = 1 + (j-1)*(nx+1) + (k-1)*(nx+1)*(ny+1)
        push!(fixed_dofs, 3*node-2, 3*node-1, 3*node)
    end
    for j in 1:(ny+1), k in 1:(nz+1)
        node = (nx+1) + (j-1)*(nx+1) + (k-1)*(nx+1)*(ny+1)
        push!(fixed_dofs, 3*node-2)
    end
    free_dofs = setdiff(1:ndofs, fixed_dofs)

    K_free = K[free_dofs, free_dofs]
    K_csr = SparseMatrixCSC(K_free)
    K_gpu_val = CuArray{Float64}(K_csr.nzval)
    K_gpu_colind = CuArray{Int32}(K_csr.rowval)
    K_gpu_rowptr = CuArray{Int32}(K_csr.colptr)

    F = zeros(ndofs)
    load_node = div(nx+1,2) + div(ny+1,2)*(nx+1) + (nz+1)*(nx+1)*(ny+1)
    F[3*load_node] = -1.0
    F_gpu = CuArray{Float64}(F[free_dofs])

    x_gpu = CUDA.fill(Float64(volfrac), nelems)
    xPhys_gpu = copy(x_gpu)
    xold_gpu = copy(x_gpu)

    edof_gpu = CuArray{Int32}(edof)
    Ke0_gpu = CuArray{Float64}(Ke0)

    u_free_gpu = CUDA.zeros(Float64, length(free_dofs))
    u_full_gpu = CUDA.zeros(Float64, ndofs)
    c_elem_gpu = CUDA.zeros(Float64, nelems)
    dc_gpu = CUDA.zeros(Float64, nelems)
    Ke_all_gpu = CUDA.zeros(Float64, nelems, 24, 24)

    xmin_vec = CUDA.zeros(Float64, nelems)
    xmax_vec = CUDA.ones(Float64, nelems)

    change = 1.0
    loop = 0
    c_history = Float64[]
    
    # Trackers for convergence
    iter_classical = -1
    iter_mkts = -1
    mkts_met = false

    while loop < maxiter
        loop += 1
        copyto!(xold_gpu, x_gpu)

        apply_gpu_filter!(xPhys_gpu, x_gpu, nx, ny, nz, rmin)

        threads = 256
        blocks = cld(nelems, threads)
        @cuda threads=threads blocks=blocks gpu_compute_Ke_kernel!(Ke_all_gpu, xPhys_gpu, penal, Ke0_gpu, 1e-9, nelems)
        CUDA.synchronize()

        gpu_cg_solve!(u_free_gpu, K_gpu_val, K_gpu_colind, K_gpu_rowptr, F_gpu, length(free_dofs); maxiter=500, tol=1e-8, verbose=false)

        fill!(u_full_gpu, 0.0)
        u_full_gpu[CuArray{Int32}(free_dofs)] .= u_free_gpu

        @cuda threads=threads blocks=blocks gpu_element_compliance_kernel!(c_elem_gpu, u_full_gpu, Ke_all_gpu, edof_gpu, nelems)
        CUDA.synchronize()

        c = sum(c_elem_gpu)
        push!(c_history, c)

        dc_gpu .= -penal .* (xPhys_gpu .^ (penal - 1.0)) .* c_elem_gpu
        dc_filtered_gpu = similar(dc_gpu)
        apply_gpu_filter!(dc_filtered_gpu, dc_gpu, nx, ny, nz, rmin)

        vol = sum(xPhys_gpu) / nelems

        l1 = 0.0; l2 = 1e9; move = 0.2
        while (l2 - l1) > 1e-4
            lmid = 0.5 * (l2 + l1)
            xnew_gpu = x_gpu .* sqrt.(-dc_filtered_gpu ./ lmid)
            xnew_gpu = max.(xmin_vec, min.(xmax_vec, max.(x_gpu .- move, min.(x_gpu .+ move, xnew_gpu))))
            if sum(xnew_gpu) - volfrac * nelems > 0
                l1 = lmid
            else
                l2 = lmid
            end
        end
        copyto!(x_gpu, xnew_gpu)

        change = maximum(abs.(x_gpu .- xold_gpu))

        # Check MK-TS Convergence 
        if !mkts_met && check_mk_ts(c_history, loop, winSize, alpha, slopeTolRel, minIter, relaxFactor, safeguardAt)
            iter_mkts = loop
            mkts_met = true
            if verbose 
                println("   -> MK-TS ($preset_name) triggered at iter $loop")
            end
        end

        # Check Classical Convergence
        if change <= tolx
            iter_classical = loop
            if verbose 
                println("   -> Classical triggered at iter $loop")
            end
            break # We stop the simulation when the baseline classical constraint is met
        end
    end

    # Edge case: If MK-TS never triggered before classical
    if iter_mkts == -1 
        iter_mkts = maxiter 
    end

    return Dict(
        "nx" => nx, "ny" => ny, "nz" => nz,
        "preset" => preset_name,
        "iter_classical" => iter_classical,
        "iter_mkts" => iter_mkts,
        "compliance_final" => c_history[end],
        "xPhys" => Array(xPhys_gpu) # Needed if we want to visualize or export the final mesh
    )
end

